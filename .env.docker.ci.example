# GitHub Actions CI only. Copy this file and fill in CI/test-safe values:
#   cp .env.docker.ci.example .env.docker.ci
#
# Store the filled file in GitHub secret ENV_DOCKER_CI.
# Do not put production, VPS, or live payment credentials here.
# POSTGRES_PASSWORD must match the password in DATABASE_URL.
# DATABASE_URL must use hostname postgres (the Compose service).

APP_ENV=
DOCKER_ENV_FILE=.env.docker.ci

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Backend ---
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=
FINANCIAL_ENCRYPTION_KEY=

ZARINPAL_MERCHANT_ID=
ZARINPAL_BASE_URL=
ZARINPAL_CALLBACK_URL=
FRONTEND_URL=

# --- Admin bootstrap (optional) ---
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=

# --- Frontend ---
BACKEND_URL=
