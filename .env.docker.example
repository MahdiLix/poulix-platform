# Local Docker Compose environment (do not commit real secrets).
# Copy this file and edit values:
#   cp .env.docker.example .env.docker
#
# Start:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.docker up --build
#
# Optional Rate Limit test mode (small dedicated TEST_RATE_LIMITS):
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml -f docker-compose.rate-limit.yml --env-file .env.docker up --build -d
#
# Public origin is http://localhost (Nginx). Do not use this file in production.
# POSTGRES_PASSWORD must match the password in DATABASE_URL.

APP_ENV=development

# --- PostgreSQL (Compose service hostname: postgres) ---
POSTGRES_USER=poulix
POSTGRES_PASSWORD=local-docker-only-change-before-use
POSTGRES_DB=poulix_db

# --- Backend ---
DATABASE_URL=postgresql://poulix:local-docker-only-change-before-use@postgres:5432/poulix_db?schema=public
JWT_SECRET=local-docker-only-jwt-secret-change-before-use-32
JWT_EXPIRES_IN_SECONDS=600
FINANCIAL_ENCRYPTION_KEY=local-docker-only-financial-key-change-me-32

ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com
ZARINPAL_CALLBACK_URL=http://localhost/deposit/callback
FRONTEND_URL=http://localhost

# --- Admin bootstrap (optional) ---
ADMIN_EMAIL=admin@poulix.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-docker-only-admin-password
ADMIN_RESET_PASSWORD=false

# --- Frontend (in-container Next.js rewrite fallback; browsers use Nginx /api) ---
BACKEND_URL=http://backend:3001

# Rate-limit Redis URL is set by docker-compose.rate-limit.yml / docker-compose.prod.yml.
# Leave unset in this file so normal local runs keep Rate Limiting OFF without Redis.
