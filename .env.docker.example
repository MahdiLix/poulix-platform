# Docker Compose environment (do not commit real secrets).
# Copy this file to .env.docker and adjust values:
#   cp .env.docker.example .env.docker
#
# Start stack with:
#   docker compose --env-file .env.docker up --build

# --- PostgreSQL ---
POSTGRES_USER=poulix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=poulix_db

# --- Backend (Compose network: use hostname "postgres", not localhost) ---
DATABASE_URL=postgresql://poulix:change-me@postgres:5432/poulix_db?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=900
FINANCIAL_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# Browser callback through Nginx.
# Local Docker: http://localhost/deposit/callback
# Production (poulix.ir behind Cloudflare): https://poulix.ir/deposit/callback
ZARINPAL_CALLBACK_URL=http://localhost/deposit/callback
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com
# Public origin of the UI (Nginx).
# Local Docker: http://localhost
# Production: https://poulix.ir
FRONTEND_URL=http://localhost

# --- Admin bootstrap ---
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Set to true only if you need the env password applied to an existing admin:
ADMIN_RESET_PASSWORD=false

# --- Frontend ---
# Browser API calls go through Nginx (/api → backend).
# BACKEND_URL is only for Next.js in-container rewrites if a request
# reaches the frontend container on the Docker network.
BACKEND_URL=http://backend:3001

# --- Production (poulix.ir, Cloudflare Full Strict) ---
# Copy this file to .env.docker and set:
#   FRONTEND_URL=https://poulix.ir
#   ZARINPAL_CALLBACK_URL=https://poulix.ir/deposit/callback
# Canonical public origin is https://poulix.ir (www.poulix.ir redirects there).
# Host certificate directory /etc/nginx/certs must contain:
#   origin.crt   Cloudflare Origin Certificate
#   origin.key   Origin Certificate private key
#   client.crt   Cloudflare Authenticated Origin Pull client certificate
