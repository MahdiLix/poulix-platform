# Production Docker Compose environment (do not commit real secrets).
# Copy this file on the VPS and edit values:
#   cp .env.production.example .env.production
#
# Start:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Canonical public origin is https://poulix.ir (www.poulix.ir redirects there).
# Local Docker values (localhost, sandbox merchant) must not be used here.
# POSTGRES_PASSWORD must match the password in DATABASE_URL.

APP_ENV=production
NODE_ENV=production

# --- PostgreSQL (Compose service hostname: postgres; not published on the host) ---
POSTGRES_USER=poulix
POSTGRES_PASSWORD=set-a-unique-strong-production-password
POSTGRES_DB=poulix_db

# --- Backend ---
DATABASE_URL=postgresql://poulix:set-a-unique-strong-production-password@postgres:5432/poulix_db?schema=public
JWT_SECRET=set-a-unique-strong-production-jwt-secret-min-32-chars
JWT_EXPIRES_IN_SECONDS=900
FINANCIAL_ENCRYPTION_KEY=set-a-unique-strong-production-financial-key

ZARINPAL_MERCHANT_ID=replace-with-live-merchant-uuid
ZARINPAL_BASE_URL=https://payment.zarinpal.com
ZARINPAL_CALLBACK_URL=https://poulix.ir/deposit/callback
FRONTEND_URL=https://poulix.ir

# --- Admin bootstrap (optional) ---
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=set-a-unique-strong-production-admin-password
ADMIN_RESET_PASSWORD=false

# --- Frontend (in-container Next.js rewrite fallback; browsers use Nginx /api) ---
BACKEND_URL=http://backend:3001
