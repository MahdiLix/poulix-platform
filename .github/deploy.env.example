 
# Settings → Environments → production → Secrets.
# Do not commit a filled copy of this file.

# VPS hostname or IP
SSH_HOST=

# SSH user on the VPS
SSH_USER=sya

# Private key whose public key is in the VPS authorized_keys
SSH_PRIVATE_KEY=

# Host key line(s). Generate with:
#   ssh-keyscan -t ed25519,rsa <host>
SSH_KNOWN_HOSTS=

# Absolute path to the existing git clone on the VPS
DEPLOY_PATH=

# Optional. Defaults to 22 if left empty
SSH_PORT=
