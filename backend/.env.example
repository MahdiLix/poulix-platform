# Copy this file to .env and replace the placeholders.
# Do not put real passwords or JWT secrets in this file.
#
# Host Node.js (backend on the host):
#   - Use localhost for Postgres (Compose maps 5432, or local Postgres).
#   - Match credentials from your root .env.docker if Postgres runs in Docker.
#
# Full Docker Compose:
#   - Secrets live in root .env.docker (see .env.docker.example).
#   - DATABASE_URL there uses hostname "postgres", not localhost.

DATABASE_URL="postgresql://poulix:change-me@localhost:5432/poulix_db?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN_SECONDS="900"
# Optional dedicated key for saved destination encryption. Falls back to JWT_SECRET.
FINANCIAL_ENCRYPTION_KEY="replace-with-a-long-random-encryption-key"

# Bootstrap admin (optional). On startup the backend creates this user as ADMIN
# if missing, or promotes the matching email. Public register always stays USER.
ADMIN_EMAIL="admin@poulix.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_RESET_PASSWORD="false"

ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_CALLBACK_URL="http://localhost:3000/deposit/callback"
ZARINPAL_BASE_URL="https://sandbox.zarinpal.com"
