# Copy this file to .env and replace the placeholders.
# Do not put real passwords or JWT secrets in this file.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/poulix_db?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN_SECONDS="900"
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_CALLBACK_URL="http://localhost:3001/wallets/deposit/callback"
ZARINPAL_BASE_URL="https://sandbox.zarinpal.com"
