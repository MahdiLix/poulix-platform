# Optional for host Node.js frontend development (`next dev`).
# Copy to .env.local if you need to override defaults.
#
# Local development uses Next.js rewrites so the browser can call /api
# on the same origin as the UI:
#   BACKEND_URL=http://localhost:3001
#
# Docker / VPS: Nginx is the public reverse proxy for https://poulix.ir
# (www.poulix.ir redirects to the apex). Do not point the browser at the
# backend. Leave NEXT_PUBLIC_API_URL unset (same-origin /api).
# Frontend port 3000 is not published in Compose.

BACKEND_URL=http://localhost:3001
