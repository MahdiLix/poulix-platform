# Optional for host Node.js frontend development.
# Copy to .env.local if you need to override defaults.
#
# Host mode (default in next.config.ts):
#   BACKEND_URL=http://localhost:3001
#
# Docker Compose builds the frontend with:
#   BACKEND_URL=http://backend:3001
# so Next.js rewrites reach the backend service on the Compose network.

BACKEND_URL=http://localhost:3001
