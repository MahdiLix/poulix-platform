# Optional for host Node.js frontend development (`next dev`).
# Copy to .env.local if you need to override defaults.
#
# Local development uses Next.js rewrites so the browser can call /api
# on the same origin as the UI:
#   BACKEND_URL=http://localhost:3001
#
# Docker / VPS: Nginx is the public reverse proxy. Do not point the
# browser at the backend. Leave NEXT_PUBLIC_API_URL unset (same-origin).

BACKEND_URL=http://localhost:3001
